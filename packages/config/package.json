{
  "name": "@akiba/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig, ESLint and Prettier presets for the Akiba monorepo.",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "files": [
    "eslint",
    "prettier",
    "tsconfig"
  ],
  "scripts": {
    "build": "node -e \"console.log('@akiba/config: presets are plain JS/JSON, nothing to build')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.9 <6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
