{
  "name": "@akiba/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the Akiba API: owns the session (access token in memory, refresh via cookie or injected storage).",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@akiba/shared": "workspace:*"
  },
  "devDependencies": {
    "@akiba/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
