# Akiba API environment. Copy to apps/api/.env for local work (`.env` is git-ignored) and run
#   node --env-file=.env dist/server.js
# Every variable is validated at boot (src/config/env.ts); the process exits with a list of
# problems if any value is invalid. Do not put real secrets in this file.

# development | test | production
NODE_ENV=development

# TCP port to listen on.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection URL. Optional for the server in development/test (then /ready reports the
# database as "not_configured"); required when NODE_ENV=production. Also read by the Prisma CLI
# (pnpm db:migrate, db:check), the seed (pnpm db:seed) and the API tests, which create their own
# akiba_t_* databases on this server. `?schema=` is optional (default: public). The value below
# is a local placeholder.
DATABASE_URL=postgresql://akiba:change-me@localhost:5432/akiba?schema=public

# Comma-separated exact browser origins allowed by CORS (no path, no trailing slash, no "*").
# Empty means no cross-origin browser access.
CORS_ORIGINS=http://localhost:5173

# Rate limits per client IP per window (doc 07 §1). Leave the defaults in real deployments;
# only the smoke/e2e workflows raise API_RATE_LIMIT_MAX.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WRITE_MAX=120
# Requests per IP per window across all /v1/auth routes (login, register, refresh, logout).
API_RATE_LIMIT_AUTH_MAX=10

# Number of reverse-proxy hops whose X-Forwarded-For is trusted for the client IP.
# 0 = not behind a proxy (use the socket address). Set to 1 behind a single load balancer.
TRUST_PROXY_HOPS=0

# How long in-flight requests may take to finish after SIGTERM/SIGINT before being cut off.
SHUTDOWN_TIMEOUT_MS=10000

# --- Authentication (docs/09-security-privacy.md §2) ---

# Ed25519 signing key for access tokens, as one line of JWK JSON. SECRET. Generate with
#   pnpm auth:gen-key
# Required when NODE_ENV=production. If unset in development/test, the API generates a key for
# the running process only (access tokens then stop working at every restart).
AUTH_JWT_PRIVATE_JWK=

# Key rotation: the PUBLIC half of the key used before the current one (JWK JSON with exactly
# kty, crv, x, kid). Tokens signed with it stay valid; remove it 15 minutes after rotating.
AUTH_JWT_PREVIOUS_PUBLIC_JWK=

# `iss` and `aud` of the access tokens. A token with any other value is rejected.
AUTH_JWT_ISSUER=akiba-api
AUTH_JWT_AUDIENCE=akiba

# Optional pepper: a random secret (32+ characters) mixed into every password hash. SECRET.
# Changing or removing it invalidates every existing password, so decide before the first user.
AUTH_PASSWORD_PEPPER=

# argon2id cost. These are the minimum the API accepts (doc 09 S-AUTH-1); raise them on capable
# hardware. Changing them affects new hashes only.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2

# `Secure` flag of the refresh cookie. Must be true in production. Set to false ONLY for local
# development over plain http://localhost with a browser that refuses Secure cookies there.
AUTH_COOKIE_SECURE=true

# Also check new passwords against the Have I Been Pwned range API (k-anonymity: only 5 hex
# characters of a SHA-1 leave the server). OFF by default; the built-in list is always used.
# Not yet verified against the live service.
AUTH_HIBP_ENABLED=false

# ── Email (verification, password reset, security notices) ──
# Which provider delivers email. `console` is the only one so far: it delivers NOTHING and logs
# only that a message of some kind was produced (never the recipient, the content or the link).
# The real provider is not chosen yet; any other value stops the API at start-up.
EMAIL_PROVIDER=console

# Development aid: print whole messages, one-time links included, to the API's console so you can
# click them. Refused when NODE_ENV=production. Anyone who can read that console can take over
# the accounts concerned, so leave it off anywhere shared.
EMAIL_DEV_PRINT_LINKS=false

# Origin of the web app (no path, no trailing slash). Emailed links point to it:
#   <WEB_BASE_URL>/verify-email#token=…  and  <WEB_BASE_URL>/reset-password#token=…
# Required, and must be https://, when NODE_ENV=production. Default: http://localhost:5173
WEB_BASE_URL=http://localhost:5173
