{
  "name": "@akiba/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Akiba mobile app (Expo, React Native).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform web --platform android --output-dir dist",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@akiba/api-client": "workspace:*",
    "@akiba/shared": "workspace:*",
    "@akiba/ui-tokens": "workspace:*",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@akiba/config": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
