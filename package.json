{
  "name": "akiba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "lint": "pnpm run build:packages && eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "test": "pnpm run build:packages && pnpm -r run test",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo"
  },
  "prettier": "@akiba/config/prettier",
  "devDependencies": {
    "@akiba/config": "workspace:*",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
