// Akiba data model (docs/06-data-model.md). PostgreSQL >= 15.
//
// What this file cannot express lives as hand-written SQL in the migrations and is listed in
// prisma/README.md: the citext extension, CHECK constraints, the partial unique index for "one
// open run per entry", the generated `title.search` column and the append-only guard on `event`.
// Never run `prisma db push` against a real database: it would skip all of that.
//
// Conventions: tables and columns are snake_case (as in doc 06), models and fields are
// PascalCase/camelCase. IDs are UUIDs generated by the database. Every timestamp is timestamptz.

generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum TitleLanguage {
  romaji
  english
  native

  @@map("title_language")
}

enum LibraryView {
  grid
  list

  @@map("library_view")
}

enum OAuthProvider {
  google
  apple

  @@map("oauth_provider")
}

enum OneTimeTokenPurpose {
  verify_email
  reset_password

  @@map("one_time_token_purpose")
}

enum TitleKind {
  tv
  movie
  ova
  ona
  special
  tv_short
  music

  @@map("title_kind")
}

enum TitleStatus {
  finished
  releasing
  not_yet_released
  cancelled
  hiatus

  @@map("title_status")
}

enum Season {
  winter
  spring
  summer
  fall

  @@map("season")
}

/// Where an external ID comes from. Jikan serves MyAnimeList data, so its IDs are `mal`.
enum ExternalSource {
  anilist
  mal
  kitsu

  @@map("external_source")
}

enum RelationType {
  prequel
  sequel
  side_story
  spin_off
  parent_story
  alternative
  adaptation
  summary
  other

  @@map("relation_type")
}

enum CharacterRole {
  main
  supporting
  background

  @@map("character_role")
}

enum EntryStatus {
  watching
  completed
  planned
  on_hold
  dropped

  @@map("entry_status")
}

/// Doc 06 §3. Adding a type needs a migration (`ALTER TYPE event_type ADD VALUE`).
enum EventType {
  entry_added
  status_changed
  progress_changed
  run_started
  run_completed
  rated
  reviewed
  favorited
  unfavorited
  total_overridden
  total_override_cleared
  entry_removed

  @@map("event_type")
}

enum NotificationKind {
  episode_aired

  @@map("notification_kind")
}

// ─────────────────────── Identity and auth ───────────────────────

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// citext: unique regardless of letter case.
  email           String        @unique @db.Citext
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  /// Null for accounts that only sign in through OAuth.
  passwordHash    String?       @map("password_hash")
  displayName     String?       @map("display_name")
  titleLanguage   TitleLanguage @default(romaji) @map("title_language")
  /// IANA time zone name.
  timeZone        String        @default("UTC") @map("time_zone")
  libraryView     LibraryView   @default(grid) @map("library_view")
  alertsEnabled   Boolean       @default(true) @map("alerts_enabled")
  /// Show adult-rated titles in discovery and let them be added (Q-10: off by default).
  showAdult       Boolean       @default(false) @map("show_adult")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Soft delete: set when the user asks for deletion; the row is purged after `purgeAfter`.
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  purgeAfter      DateTime?     @map("purge_after") @db.Timestamptz(3)

  oauthAccounts  OAuthAccount[]
  refreshTokens  RefreshToken[]
  oneTimeTokens  OneTimeToken[]
  libraryEntries LibraryEntry[]
  events         Event[]
  notifications  Notification[]
  shareLink      ShareLink?

  @@index([purgeAfter])
  @@map("user")
}

model OAuthAccount {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_account")
}

model RefreshToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// All tokens descended from one login share a family (reuse detection revokes the family).
  familyId        String    @map("family_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// Idle deadline of THIS token: unused past it, the session is over (S-AUTH-6: 14 days).
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Absolute deadline of the whole family, fixed at login and copied on every rotation
  /// (S-AUTH-6: 30 days). No token of the family is valid past it.
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById    String?   @map("replaced_by_id") @db.Uuid
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model OneTimeToken {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique @map("token_hash")
  /// The address the link was emailed to: the mailbox this token proves control of.
  sentTo    String              @map("sent_to") @db.Citext
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("one_time_token")
}

// ─────────────────── Catalog (shared, user-independent) ───────────────────

/// A title's `id` is the Akiba ID: the only title identifier users' data ever references.
model Title {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            TitleKind
  titleRomaji     String?                  @map("title_romaji")
  titleEnglish    String?                  @map("title_english")
  titleNative     String?                  @map("title_native")
  synonyms        String[]                 @default([])
  synopsis        String?
  coverUrl        String?                  @map("cover_url")
  /// The cover art's dominant colour as `#rrggbb` when the source supplies one (AniList does); tickets are printed on it.
  coverColor      String?                  @map("cover_color")
  /// The show's Crunchyroll series page, when AniList lists one.
  crunchyrollUrl String? @map("crunchyroll_url")
  /// Episode number to Crunchyroll watch URL, as far as AniList lists them (often partial). {"1": "https://..."}
  crunchyrollEpisodes Json? @map("crunchyroll_episodes")
  /// Every streaming service AniList lists for the show: [{"site": "Netflix", "url": "https://..."}].
  streamingLinks Json? @map("streaming_links")
  bannerUrl       String?                  @map("banner_url")
  /// The source's own format label, kept verbatim; `kind` is the normalised value.
  format          String?
  status          TitleStatus
  /// Episode count reported by the source; null while unknown.
  episodesTotal   Int?                     @map("episodes_total")
  durationMin     Int?                     @map("duration_min")
  season          Season?
  seasonYear      Int?                     @map("season_year")
  startDate       DateTime?                @map("start_date") @db.Date
  endDate         DateTime?                @map("end_date") @db.Date
  /// 0-100.
  averageScore    Int?                     @map("average_score")
  popularity      Int?
  isAdult         Boolean                  @default(false) @map("is_adult")
  franchiseId     String?                  @map("franchise_id") @db.Uuid
  sourceUpdatedAt DateTime?                @map("source_updated_at") @db.Timestamptz(3)
  fetchedAt       DateTime?                @map("fetched_at") @db.Timestamptz(3)
  /// When studios, relations and the next airing were last fetched; null = only card data so far.
  detailFetchedAt DateTime?                @map("detail_fetched_at") @db.Timestamptz(3)
  stale           Boolean                  @default(false)
  /// Generated column (see the migration): weighted tsvector over the titles and synonyms.
  /// Read-only, and invisible to the Prisma client; query it with raw SQL.
  /// The `dbgenerated` default below is how Prisma's introspection reports a generated column;
  /// it must match the expression in the migration or `pnpm db:check` reports drift.
  search          Unsupported("tsvector")? @default(dbgenerated("title_search_vector(title_romaji, title_english, title_native, synonyms)"))

  franchise        Franchise?        @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  externalIds      TitleExternalId[]
  relationsFrom    TitleRelation[]   @relation("TitleRelationFrom")
  relationsTo      TitleRelation[]   @relation("TitleRelationTo")
  studios          TitleStudio[]
  genres           TitleGenre[]
  characters       TitleCharacter[]
  airingEpisodes   AiringEpisode[]
  episodeInfo      EpisodeInfo[]
  mappingOverrides MappingOverride[]
  libraryEntries   LibraryEntry[]
  events           Event[]
  notifications    Notification[]

  @@index([seasonYear, season])
  @@index([franchiseId])
  @@index([search], type: Gin)
  @@map("title")
}

model TitleExternalId {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleId    String         @map("title_id") @db.Uuid
  source     ExternalSource
  externalId String         @map("external_id")

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([titleId])
  @@map("title_external_id")
}

model TitleRelation {
  fromTitleId  String       @map("from_title_id") @db.Uuid
  toTitleId    String       @map("to_title_id") @db.Uuid
  relationType RelationType @map("relation_type")

  fromTitle Title @relation("TitleRelationFrom", fields: [fromTitleId], references: [id], onDelete: Cascade)
  toTitle   Title @relation("TitleRelationTo", fields: [toTitleId], references: [id], onDelete: Cascade)

  @@id([fromTitleId, toTitleId, relationType])
  @@index([toTitleId])
  @@map("title_relation")
}

/// Derived: connected components of `title_relation`, recomputed when relations change.
model Franchise {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  /// TV titles on the main line (prequel/sequel chain) of the franchise: its "seasons". Null until counted.
  seasonCount Int? @map("season_count")

  titles Title[]

  @@map("franchise")
}

model Studio {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  /// e.g. `{"anilist": "569"}`.
  externalIds       Json    @default("{}") @map("external_ids")
  isAnimationStudio Boolean @default(true) @map("is_animation_studio")

  titles TitleStudio[]

  @@map("studio")
}

model TitleStudio {
  titleId  String  @map("title_id") @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  isMain   Boolean @default(false) @map("is_main")

  title  Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([titleId, studioId])
  @@index([studioId])
  @@map("title_studio")
}

model Genre {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  titles TitleGenre[]

  @@map("genre")
}

model TitleGenre {
  titleId String @map("title_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@index([genreId])
  @@map("title_genre")
}

model Character {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  nativeName  String? @map("native_name")
  imageUrl    String? @map("image_url")
  description String?
  externalIds Json    @default("{}") @map("external_ids")

  titles       TitleCharacter[]
  voiceActors  CharacterVoiceActor[]

  @@map("character")
}

/// A person who voices characters. `external_ids` is `{"anilist": "95000"}`; a unique expression index
/// on the AniList ID (migration SQL) keeps one row per person.
model VoiceActor {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  nativeName  String? @map("native_name")
  imageUrl    String? @map("image_url")
  externalIds Json    @default("{}") @map("external_ids")

  characters CharacterVoiceActor[]

  @@map("voice_actor")
}

/// Who voices a character, per language (the voice does not change between the character's titles).
model CharacterVoiceActor {
  characterId  String @map("character_id") @db.Uuid
  voiceActorId String @map("voice_actor_id") @db.Uuid
  language     String

  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  voiceActor VoiceActor @relation(fields: [voiceActorId], references: [id], onDelete: Cascade)

  @@id([characterId, voiceActorId, language])
  @@index([voiceActorId])
  @@map("character_voice_actor")
}

model TitleCharacter {
  titleId     String        @map("title_id") @db.Uuid
  characterId String        @map("character_id") @db.Uuid
  role        CharacterRole

  title     Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([titleId, characterId])
  @@index([characterId])
  @@map("title_character")
}

/// The name and synopsis of one episode, from Jikan, fetched the first time somebody asks for it.
model EpisodeInfo {
  titleId       String   @map("title_id") @db.Uuid
  episodeNumber Int      @map("episode_number")
  name          String?
  synopsis      String?
  fetchedAt     DateTime @map("fetched_at") @db.Timestamptz(3)

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([titleId, episodeNumber])
  @@map("episode_info")
}

model AiringEpisode {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleId          String         @map("title_id") @db.Uuid
  episodeNumber    Int            @map("episode_number")
  airsAt           DateTime       @map("airs_at") @db.Timestamptz(3)
  source           ExternalSource
  /// Set once the inbox fan-out has handled this episode.
  airedProcessedAt DateTime?      @map("aired_processed_at") @db.Timestamptz(3)

  title         Title          @relation(fields: [titleId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([titleId, episodeNumber])
  @@index([airsAt])
  @@map("airing_episode")
}

/// Review queue: two external IDs the mapping dataset links in a way that contradicts our data.
model MappingConflict {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceA    ExternalSource @map("source_a")
  idA        String         @map("id_a")
  sourceB    ExternalSource @map("source_b")
  idB        String         @map("id_b")
  reason     String
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(3)

  @@index([resolvedAt])
  @@map("mapping_conflict")
}

/// Manual mapping decisions; they win over the dataset.
/// One row of the community ID-mapping dataset (doc 05 §5): the IDs one title has at each source.
/// Imported weekly; read when a title is resolved for the first time. At least two IDs per row
/// (a CHECK in the migration): a row with one ID maps nothing.
model MappingDatasetEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anilistId  String?  @unique @map("anilist_id")
  malId      String?  @unique @map("mal_id")
  kitsuId    String?  @unique @map("kitsu_id")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  @@map("mapping_dataset_entry")
}

model MappingOverride {
  source     ExternalSource
  externalId String         @map("external_id")
  titleId    String         @map("title_id") @db.Uuid

  title Title @relation(fields: [titleId], references: [id], onDelete: Restrict)

  @@id([source, externalId])
  @@index([titleId])
  @@map("mapping_override")
}

// ─────────────────────────── User data ───────────────────────────

model LibraryEntry {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String      @map("user_id") @db.Uuid
  titleId               String      @map("title_id") @db.Uuid
  status                EntryStatus
  /// Mirrors the current run's progress. CHECK: >= 0 and <= episodes_total_override when set.
  progress              Int         @default(0)
  /// CHECK: >= 1.
  episodesTotalOverride Int?        @map("episodes_total_override")
  /// CHECK: 1-10.
  rating                Int?        @db.SmallInt
  review                String?
  isFavorite            Boolean     @default(false) @map("is_favorite")
  /// Null = follow the user's setting.
  alertsEnabled         Boolean?    @map("alerts_enabled")
  notes                 String?
  startedAt             DateTime?   @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?   @map("completed_at") @db.Timestamptz(3)
  addedAt               DateTime    @default(now()) @map("added_at") @db.Timestamptz(3)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft removal: the row stays as a tombstone so its events keep a target (doc 06 §3).
  removedAt             DateTime?   @map("removed_at") @db.Timestamptz(3)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  Title        @relation(fields: [titleId], references: [id], onDelete: Restrict)
  runs   ViewingRun[]
  events Event[]

  @@unique([userId, titleId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([titleId])
  @@map("library_entry")
}

/// The current run is the one with `finished_at IS NULL`; a partial unique index (migration SQL)
/// allows at most one per entry.
model ViewingRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId       String    @map("entry_id") @db.Uuid
  /// 1, 2, ... CHECK: >= 1.
  runNumber     Int       @map("run_number")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  /// CHECK: 1-10.
  rating        Int?      @db.SmallInt
  /// CHECK: >= 0.
  progressAtEnd Int?      @map("progress_at_end")

  entry  LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([entryId, runNumber])
  @@map("viewing_run")
}

/// Append-only. A database trigger rejects UPDATE, DELETE and TRUNCATE; see prisma/README.md for
/// the two documented exceptions (account purge, title merge).
model Event {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  entryId    String    @map("entry_id") @db.Uuid
  titleId    String    @map("title_id") @db.Uuid
  runId      String?   @map("run_id") @db.Uuid
  type       EventType
  payload    Json      @default("{}")
  /// When it happened for the user; `createdAt` is when the row was written.
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Total order of writing (a database sequence): breaks ties between events with the same
  /// `occurredAt`, so the timeline never reorders what happened in one request.
  seq        BigInt    @default(autoincrement())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title Title        @relation(fields: [titleId], references: [id], onDelete: Restrict)
  run   ViewingRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc), seq(sort: Desc)])
  @@index([entryId, occurredAt, seq])
  @@index([titleId])
  @@index([runId])
  @@map("event")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  titleId   String           @map("title_id") @db.Uuid
  episodeId String           @map("episode_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   Title         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode AiringEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([episodeId])
  @@index([titleId])
  @@map("notification")
}

/// At most one per user: revoke sets `revoked_at`, regenerate replaces `token_hash` in place.
model ShareLink {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  /// `{ statuses: [], show_ratings: bool, show_reviews: bool }`.
  scope     Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("share_link")
}
